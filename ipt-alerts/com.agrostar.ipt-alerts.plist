<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agrostar.ipt-alerts</string>

    <!-- Runs the DEPLOYED copy at ~/.ipt-alerts/ (not the repo copy):
         launchd agents cannot read ~/Documents (macOS TCC privacy protection).
         After editing ipt-alerts/ in the repo, redeploy with:
           cp ipt-alerts/run.py ipt-alerts/send.sh ~/.ipt-alerts/ -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/darpan/.ipt-alerts/send.sh</string>
    </array>

    <!-- Fires at login/restart AND at 10:00 AM (a missed 10 AM fires on wake).
         send.sh guards against sending more than once per day. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/darpan/.ipt-alerts/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/darpan/.ipt-alerts/logs/launchd.log</string>
</dict>
</plist>
