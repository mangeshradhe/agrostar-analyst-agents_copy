<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agrostar.coco-alerts</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/darpan/Documents/claude code/DVS Analysis/coco_alerts/run.py</string>
    </array>

    <!-- 9:00 AM local (IST). If the laptop is asleep, launchd fires once on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/darpan/Documents/claude code/DVS Analysis/coco_alerts/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/darpan/Documents/claude code/DVS Analysis/coco_alerts/logs/launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
